# Public browser configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_CLIENT_ID=

# Server-only values belong in Supabase Edge Function secrets, not Vercel's
# browser environment and never in a committed .env.local file.
APP_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Email (Edge Function secret). EMAIL_FROM must be an address on a domain verified in Resend,
# e.g. "Bookings <bookings@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# Booking and Google Calendar (Edge Function secrets).
# One Google OAuth app (Google Cloud Console > APIs & Services > Credentials > OAuth client ID,
# type "Web application") serves every seller: each seller connects their OWN Google account
# from Dashboard > Bookings > Settings. Authorised redirect URI:
#   <SUPABASE_URL>/functions/v1/google-calendar
# Enable the "Google Calendar API" for the project. Scopes used: calendar.events, calendar.freebusy.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random 32+ character strings (e.g. `openssl rand -hex 32`). Do not reuse and do not rotate
# CALENDAR_TOKEN_KEY or BOOKING_TOKEN_SECRET casually: it invalidates stored calendar
# connections and customer booking links.
CALENDAR_TOKEN_KEY=
BOOKING_TOKEN_SECRET=
# Shared secret the scheduler sends in the x-cron-secret header to booking-reminders.
BOOKING_CRON_SECRET=
